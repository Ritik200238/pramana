# ---- Database ----
DATABASE_URL=postgres://localhost:5432/ogt

# ---- 0G Compute (Router) ----
# Create at https://pc.0g.ai -> connect wallet -> deposit 0G -> API Keys.
# Must be an inference key (sk-). Management keys (mk-) cannot call inference.
# How this deployment reaches 0G Compute.
#   router  the hosted Router, with an sk- key below. Simpler to operate.
#   broker  pays providers directly from OG_STORAGE_PRIVATE_KEY, no key from
#           anybody, settlement on 0G Chain. Needs @0glabs/0g-serving-broker
#           installed, which carries 20 production advisories — see
#           VERIFICATION.md before choosing it.
OG_INFERENCE_MODE=router

# Required when OG_INFERENCE_MODE=router. Ignored in broker mode.
OG_ROUTER_API_KEY=sk-

# ---- 0G Storage ----
# Backend key that PAYS for storage writes. It does not own anything:
# records are ECIES-encrypted to each user's own key, and anchors are written
# by the user's address. Holding this grants no ability to read or forge a record.
OG_STORAGE_PRIVATE_KEY=0x

OG_NETWORK=testnet

# The public RPCs are documented as development-only. Use a third-party
# endpoint (Ankr, dRPC) in production.
# OG_RPC_URL_OVERRIDE=

# Deployed HealthRecordAnchor address, once it exists.
# OG_ANCHOR_ADDRESS=

# ---- Server ----
PORT=8080
CORS_ORIGINS=http://localhost:5173

# Operator secret for /admin/* endpoints. At least 32 characters.
# Leave unset and the admin surface is not mounted at all, which is the right
# default for anything that is not an operator's own deployment.
# ADMIN_TOKEN=

# ---- One-time code delivery ----
# The vendor is configuration, not code: India requires DLT registration with an
# approved sender id and templates before transactional SMS delivers at all.
# Unset in production is a boot failure — nobody could sign in, while the server
# answered 200 to every code request.
#
# The body is a JSON template. {{code}} is required; {{to}} and {{expiry}} are
# available. Substitution happens structurally, so no value can alter its shape.
#
# Example shape (fill in the ids your own DLT registration approved):
# SMS_PROVIDER_URL=https://api.msg91.com/api/v5/otp
# SMS_PROVIDER_HEADERS={"authkey":"..."}
# SMS_PROVIDER_BODY={"template_id":"...","mobile":"{{to}}","otp":"{{code}}"}

# ---- On-chain anchoring ----
# Both are required together. Without them snapshots are written to 0G Storage
# and their pointers live only in this database, which is the arrangement
# HealthRecordAnchor exists to replace.
#
# The master seed derives each user's record-owning account. Whoever holds it
# can sign for any user, so this is custodial — see packages/contracts/SECURITY.md.
# At least 32 characters, and back it up: losing it orphans every record.
# OG_ANCHOR_ADDRESS=
# OG_ANCHOR_MASTER_SEED=

# Deployed CoachAgent address. Unset means coaches are never minted and the
# ownership half of the 0G binding does no work.
# OG_COACH_ADDRESS=

# Management key for reading the Router account balance (mk-, account:read).
# A separate key by design: an inference key is refused with 403.
# Without it, the balance that keeps every model call working cannot be read —
# and when it hits zero, inference returns 402 and the product stops.
# OG_ROUTER_MANAGEMENT_KEY=

# ---- Operational knobs ----
# All have working defaults; listed so an operator knows they exist.
# NODE_ENV=development          # development | test | production
# HOST=0.0.0.0
# MAX_PHOTO_BYTES=8388608       # hard ceiling on one uploaded meal photo
