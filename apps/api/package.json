{
  "name": "@ogt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "preflight": "node --experimental-strip-types src/preflight.ts",
    "test:pipeline": "node --test --experimental-strip-types tests/live/pipeline.test.ts",
    "bench": "node scripts/bench.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@ogt/core": "*",
    "@ogt/og": "*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2"
  }
}
